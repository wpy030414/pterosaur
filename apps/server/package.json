{
  "name": "@pterosaur/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "start": "cross-env NODE_ENV=production node dist/index.js",
    "log-in": "tsx src/cli/login.ts netease",
    "log-in:bilibili": "tsx src/cli/login.ts bilibili"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.3",
    "@pterosaur/shared": "workspace:*",
    "NeteaseCloudMusicApi": "^4.32.0",
    "hono": "^4.13.12",
    "lru-cache": "^11.2.4",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "cross-env": "^10.1.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3"
  }
}
